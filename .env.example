# Local host connection. Docker Compose overrides only the hostname to `db`.
DATABASE_URL="postgresql://challenge_platform:replace-with-a-long-database-password@localhost:5432/challenge_platform?schema=public"
# Used by `prisma migrate`. Identical to DATABASE_URL unless you use a pooler
# (see "Deploying on Vercel + Supabase" in the README).
DIRECT_URL="postgresql://challenge_platform:replace-with-a-long-database-password@localhost:5432/challenge_platform?schema=public"
SESSION_SECRET="replace-with-a-long-random-secret"
CHALLENGE_SERVER_SECRET="replace-with-a-different-long-random-secret"
ADMIN_NAME="Platform Admin"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-this-admin-password"  # at least 10 characters

# Cookies are Secure (HTTPS-only) in production. Set to "false" ONLY for a
# plain-HTTP demo with no TLS, otherwise browsers will refuse to sign anyone in.
# COOKIE_SECURE="false"

# Docker Compose only: used by the bundled PostgreSQL service.
POSTGRES_USER="challenge_platform"
# Use URL-safe characters because Compose embeds this value in DATABASE_URL.
POSTGRES_PASSWORD="replace-with-a-long-database-password"
POSTGRES_DB="challenge_platform"
POSTGRES_PORT="5432"

# Docker Compose only: the published port of the app.
APP_PORT="3000"

# Optional automatic HTTPS: docker compose --profile tls up -d
# DOMAIN must resolve to this machine. Set APP_BIND=127.0.0.1 to hide port 3000.
# DOMAIN="challenges.example.com"
# APP_BIND="127.0.0.1"
